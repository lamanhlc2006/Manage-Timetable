# ===========================================
# Manage-Timetable Backend Environment Config
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/manage-timetable

# JWT Secrets (MUST change in production!)
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_STRONG_RANDOM_SECRET

# Token Encryption Key (for encrypting Google OAuth tokens in DB)
# TOKEN_ENCRYPTION_KEY=CHANGE_ME_TO_A_RANDOM_32_CHAR_STRING

# CORS (comma-separated origins)
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Google OAuth2 (optional, for Google Calendar sync)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Web Push VAPID Keys (optional, for push notifications)
# VAPID_PUBLIC_KEY=your_vapid_public_key
# VAPID_PRIVATE_KEY=your_vapid_private_key
# VAPID_EMAIL=mailto:your_email@example.com

# SMTP Email Notifications (optional, for reminder emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your_email@gmail.com
